# Global Settings
font=FiraCode Nerd Font 10
width=350
height=150
margin=10
padding=15
border-size=2
border-radius=10
icons=1
max-icon-size=48
default-timeout=5000
ignore-timeout=1

# --- Tokyo Night Theme ---
background-color=#1a1b26ff
text-color=#c0caf5ff
border-color=#7aa2f7ff
progress-color=over #2ac3deff

# Low Urgency (Grey/Blue)
[urgency=low]
border-color=#3b4261ff
default-timeout=2000

# Normal Urgency (Blue/Cyan)
[urgency=normal]
border-color=#7aa2f7ff

# High Urgency (Red/Orange)
[urgency=critical]
background-color=#1a1b26ff
text-color=#f7768eff
border-color=#f7768eff
default-timeout=0
