# Global Settings
font=Inter Variable Font 10
width=350
height=150
margin=10
padding=15
border-size=2
border-radius=10
icons=1
max-icon-size=48
default-timeout=5000
ignore-timeout=1

# Gruvbox Dark Soft Theme
background-color=#32302f
text-color=#ebdbb2
border-color=#83a598
progress-color=over #b8bb26

[urgency=low]
border-color=#32302f
default-timeout=2000

[urgency=critical]
border-color=#fb4934
text-color=#fb4934
default-timeout=0
