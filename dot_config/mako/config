# Global Settings
font=Inter Variable Font 10
width=350
height=150
margin=10
padding=15
border-size=2
border-radius=10
icons=1
max-icon-size=48
default-timeout=5000
ignore-timeout=1
on-notify=exec mpv --no-video /usr/share/sounds/freedesktop/stereo/message.oga

# Gruvbox Dark Hard Theme
background-color=#1d2021
text-color=#ebdbb2
border-color=#a89984
progress-color=over #8ec07c

[urgency=low]
border-color=#1d2021
default-timeout=2000

[urgency=critical]
border-color=#fb4934
text-color=#fb4934
default-timeout=0

